{
  "name": "ssa-cs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "description": "Sistema de control de acceso de la FCBIyT (UATx): monorepo frontend (Electron) + backend (Express) + shared",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "pnpm --filter @ssa/frontend start",
    "dev": "pnpm --filter @ssa/frontend dev",
    "dev:back": "pnpm --filter @ssa/backend dev",
    "start:back": "pnpm --filter @ssa/backend start",
    "test": "pnpm --filter @ssa/shared test && pnpm --filter @ssa/backend test",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down"
  }
}
