# Copia este archivo como backend/.env (no se sube a git)

# Servidor HTTP
PORT=3000

# Base de datos MySQL (en desarrollo, `pnpm db:up` levanta 127.0.0.1:3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=ssa_dev_root
DB_NAME=sistemaaccesofacultad

# Secreto de la cookie de sesión del administrador (cadena larga y aleatoria)
SESSION_SECRET=

# Acceso al modo administrador
ADMIN_USUARIO=
ADMIN_PASSWORD=

# Firma de los QR de las credenciales. Copia el valor actual del frontend.
# RESPÁLDALO: si cambia o se pierde, todas las credenciales emitidas dejan de servir.
QR_SECRETO=
# QR_ACEPTAR_SIN_FIRMA=no

# Correo y buzón de confirmaciones
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONFIRMACION_URL=https://registro-fcbiyt.fcbiyt-uatx.workers.dev
CONFIRMACION_API_KEY=

# Cierre diario y respaldos
CIERRE_HORA=20:00
# CIERRE_CARPETA=
# RESPALDO_CARPETA=
# RESPALDO_DIAS=30
# RESPALDO_MYSQLDUMP=
